{
  "name": "dotelse-desktop",
  "version": "0.4.1",
  "description": "A file, with room for its context. Local .else reading, creation and editing.",
  "author": "Cyberdelic OS",
  "license": "MIT",
  "homepage": "https://dotelse.app/",
  "repository": "https://github.com/doctorillumination/else-file-format",
  "main": "main.cjs",
  "scripts": {
    "prepare:app": "python3 build_desktop.py",
    "start": "electron .",
    "test": "node test_desktop.cjs",
    "package": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "app.dotelse.desktop",
    "productName": "Dotelse",
    "directories": {
      "output": "../output/desktop-release",
      "buildResources": "../assets"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "boundary.cjs",
      "app/**/*",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "fileAssociations": [
      {
        "ext": "else",
        "name": "Dotelse file",
        "description": "Material, context and chosen provenance",
        "mimeType": "application/vnd.cyberdelic.else+zip",
        "role": "Editor"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "../assets/ElseIcon.png",
      "target": [
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "Dotelse-${version}-macOS-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "icon": "../assets/ElseIcon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Dotelse-${version}-Windows-${arch}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "icon": "../assets/ElseIcon.png",
      "category": "Office",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Dotelse-${version}-Linux-${arch}.${ext}",
      "maintainer": "Cyberdelic OS"
    }
  }
}
